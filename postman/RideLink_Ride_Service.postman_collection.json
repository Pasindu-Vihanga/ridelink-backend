{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-6c7d-0e1f-2a3b4c5d6e7f",
    "name": "RideLink - Ride Management Service API",
    "description": "Postman collection for RideLink Ride Management Service demonstrating end-to-end ride lifecycle, interservice coordination with Account Service & Driver Service, and error handling for IT3130.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ride Creation & Assignment (Interservice)",
      "item": [
        {
          "name": "Create Ride Request & Auto-Assign Driver (Positive)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"{{passengerId}}\",\n  \"pickupAddress\": \"Colombo Fort Railway Station\",\n  \"pickupLatitude\": 6.9344,\n  \"pickupLongitude\": 79.8428,\n  \"serviceArea\": \"Colombo\",\n  \"dropoffAddress\": \"Majestic City, Bambalapitiya\",\n  \"dropoffLatitude\": 6.8924,\n  \"dropoffLongitude\": 79.8553,\n  \"vehicleType\": \"CAR\",\n  \"estimatedDistanceKm\": 5.8\n}"
            },
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"rideId\", jsonData.id);",
                  "}",
                  "pm.test(\"Ride status is ASSIGNED\", function () {",
                  "    pm.expect(jsonData.status).to.eql('ASSIGNED');",
                  "});",
                  "pm.test(\"Driver is assigned\", function () {",
                  "    pm.expect(jsonData.driverId).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Ride Details by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/{{rideId}}",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "{{rideId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns correct ride ID\", function () {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"rideId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Ride Lifecycle State Transitions",
      "item": [
        {
          "name": "Step 1: Driver Accepts Ride (ASSIGNED -> ACCEPTED)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/{{rideId}}/accept",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "accept"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Ride status is ACCEPTED\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ACCEPTED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 2: Driver Starts Trip (ACCEPTED -> IN_PROGRESS)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/{{rideId}}/start",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "start"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Ride status is IN_PROGRESS\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql('IN_PROGRESS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 3: Driver Completes Trip (IN_PROGRESS -> COMPLETED)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/{{rideId}}/complete",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Ride status is COMPLETED\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql('COMPLETED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cancel Ride Scenario (Positive)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Passenger requested route cancellation\"\n}"
            },
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/{{secondRideId}}/cancel",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "{{secondRideId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ride History & Filters",
      "item": [
        {
          "name": "Get Passenger Ride History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/passenger/{{passengerId}}",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "passenger", "{{passengerId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of rides\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Driver Ride History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/driver/{{driverProfileId}}",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "driver", "{{driverProfileId}}"]
            }
          }
        },
        {
          "name": "Get Rides Filtered by Status (COMPLETED)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides?status=COMPLETED",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides"],
              "query": [{ "key": "status", "value": "COMPLETED" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Negative Scenarios",
      "item": [
        {
          "name": "Negative 1: Missing Required Fields (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"\",\n  \"pickupAddress\": \"\"\n}"
            },
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Validation error structure returned\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Negative 2: Invalid State Transition - Cancel Completed Ride (400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Trying to cancel completed trip\"\n}"
            },
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/{{rideId}}/cancel",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "{{rideId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error is Invalid State Transition\", function () {",
                  "    pm.expect(pm.response.json().error).to.include('Invalid State Transition');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Negative 3: Get Non-Existent Ride (404 Not Found)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{rideBaseUrl}}/api/rides/nonexistent-ride-id-999",
              "host": ["{{rideBaseUrl}}"],
              "path": ["api", "rides", "nonexistent-ride-id-999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
